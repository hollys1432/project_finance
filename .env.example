# ==================================================
# 로컬 개발 환경 설정 (.env.local)
# ==================================================
# 로컬 PostgreSQL 사용 시
SECRET_KEY=django-insecure-local-dev-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 로컬 데이터베이스
DATABASE_URL=postgresql://postgres:1234@localhost:5432/finance


# ==================================================
# 프로덕션 DB 연결 설정 (.env.production)
# ==================================================
# 로컬에서 Render 프로덕션 DB에 연결하여 데이터를 수집할 때 사용

# Django Settings
SECRET_KEY=your-production-secret-key
DEBUG=False
ALLOWED_HOSTS=.render.com,localhost,127.0.0.1

# Render External Database URL (Render Dashboard에서 복사)
# 형식: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# 예시: postgresql://finance_user:abc123xyz@dpg-xxxxx-oregon-postgres.render.com/finance_db
DATABASE_URL=postgresql://your-user:your-password@dpg-xxxxx.oregon-postgres.render.com/your-database


# ==================================================
# Render 환경 변수 설정 (Render Dashboard)
# ==================================================
# Render Dashboard > Environment Variables에 다음을 설정:
#
# SECRET_KEY=<강력한-시크릿-키>
# DEBUG=False
# ALLOWED_HOSTS=.render.com
# DATABASE_URL=<자동으로-설정됨-PostgreSQL-연결-시>
