# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.render.com,localhost,127.0.0.1

# Database Settings (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: Manual Database Settings
DB_NAME=finance
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# 초기 데이터 자동 로딩 설정 (Render build.sh에서 사용)
# 주의: Yahoo Finance API 제한으로 빌드 시 실패 가능성 높음
# 권장: 배포 완료 후 로컬에서 프로덕션 DB 연결하여 데이터 로딩
INIT_DATA=false
INIT_MODE=quick  # quick, kr-only, us-only, full
