# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.render.com,localhost,127.0.0.1

# Database Settings (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: Manual Database Settings
DB_NAME=finance
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# 초기 데이터 자동 로딩 설정 (Render build.sh에서 사용)
# 주의: 빌드 타임아웃 위험이 있으므로 권장하지 않음
# 대신 배포 후 Render Shell에서 "python manage.py init_data --quick" 실행 권장
INIT_DATA=false
INIT_MODE=quick  # quick, kr-only, us-only, full
